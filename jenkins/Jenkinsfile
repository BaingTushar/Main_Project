pipeline {
    agent any

    environment {
        DOCKER_HUB_USER = 'tusharbaing'
        IMAGE_NAME_BACKEND = "${DOCKER_HUB_USER}/three-tier-backend"
        IMAGE_NAME_FRONTEND = "${DOCKER_HUB_USER}/three-tier-frontend"
        TAG = "${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'main', url: 'https://github.com/BaingTushar/Main_Project.git'
            }
        }

        stage('Build Docker Images') {
            steps {
                sh 'docker build -t ${IMAGE_NAME_BACKEND}:${TAG} ./app/backend'
                sh 'docker build -t ${IMAGE_NAME_FRONTEND}:${TAG} ./app/frontend'
            }
        }

        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'docker-hub-credentials', usernameVariable: 'USER', passwordVariable: 'PASS')]) {
                    // Single quotes prevent Groovy interpolation warnings
                    sh 'echo "$PASS" | docker login -u "$USER" --password-stdin'
                    sh 'docker push ${IMAGE_NAME_BACKEND}:${TAG}'
                    sh 'docker push ${IMAGE_NAME_FRONTEND}:${TAG}'
                }
            }
        }

        stage('Update GitOps Manifests') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'github-token', usernameVariable: 'GH_USER', passwordVariable: 'GH_TOKEN')]) {
                    // Single quotes around script block ensure secure secret expansion
                    sh '''
                        sed -i "s|image: ${IMAGE_NAME_BACKEND}.*|image: ${IMAGE_NAME_BACKEND}:${TAG}|g" k8s-manifests/backend-deploy.yaml
                        sed -i "s|image: ${IMAGE_NAME_FRONTEND}.*|image: ${IMAGE_NAME_FRONTEND}:${TAG}|g" k8s-manifests/frontend-deploy.yaml
                        
                        git config user.email "jenkins@ci.com"
                        git config user.name "Jenkins CI"
                        git add k8s-manifests/
                        
                        # Only commit and push if changes exist
                        if ! git diff --cached --quiet; then
                            git commit -m "Bump image tags to version ${TAG} [skip ci]"
                            git push https://${GH_TOKEN}@github.com/BaingTushar/three-tier-gitops.git main
                        else
                            echo "No manifest changes detected. Skipping commit and push."
                        fi
                    '''
                }
            }
        }
    }

    post {
        always {
            echo "Pipeline build finished with status: ${currentBuild.currentResult}"
            
            // Uncomment once SMTP mail server is configured under Manage Jenkins -> System
            /*
            mail to: 'baingtushar123@gmail.com',
                 subject: "Jenkins Build Status: ${currentBuild.currentResult}",
                 body: "Project: ${env.JOB_NAME}\nBuild Number: ${env.BUILD_NUMBER}\nURL: ${env.BUILD_URL}"
            */
        }
    }
}
